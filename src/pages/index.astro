---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import MyCustomImageComponent from "../components/MyCustomImageComponent.astro";
import mobileImage from "../assets/pair.jpg";
import desktopImage from "../assets/pair.jpg";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>👋 Welcome to my Blog </h1>
			<p>
			<MyCustomImageComponent
   			 mobileImgUrl={mobileImage}
    		desktopImgUrl={desktopImage}
    		alt="user profile picture"
			/>
				If you'd like to read about me go to => <a href="http://localhost:4321/about">About Me</a> 
			</p>
			<p>
				I post frequent blogs about my interests; rowing, travelling, and tech at:    
				  <a href="http://localhost:4321/blog">Blog</a>
			</p>
			<p>I used Astro to help me build this project, the docs are available here</p>
			<ul>
				<li><a href="https://docs.astro.build/en/getting-started/">DOCS</a></li>
			</ul>
			
			
		</main>
		<Footer />
	</body>
</html>
